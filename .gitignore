# ---------------------------------------------------------------------------
# Secrets and private working material — never commit these
# ---------------------------------------------------------------------------

# Private mapping file (lives outside this repo, matched defensively).
# Note: a leading '../' pattern does not work in gitignore — it is not part of
# the ignore syntax, so this rule is effectively inert. The real file must be
# kept out of the repo by being outside it, not by this line.
../private/project-mapping.txt
private/

# API keys and local secrets. Applies to any file ending in .env.
.env
.env.local
.env.*.local
secrets.json
*.pem
*.key

# Private prompt/mapping drafts. The directory is ignored as a whole.
# NOTE: the tracked file prompts_for_AI/prompt_01_AMU_cylinder_only.sty predates
# this rule and stays tracked until explicitly untracked with `git rm --cached`.
prompts_for_AI/
scratch/

# ---------------------------------------------------------------------------
# Python (build123d / CadQuery / FreeCAD scripting)
# ---------------------------------------------------------------------------

# Virtual environments — keep them out of the repo. Sibling of the repo is
# preferred: ~/.venvs/cad, so nothing here is committed by accident.
venv/
.venv/
env/
ENV/

# Compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging / build output
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test + type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Jupyter
.ipynb_checkpoints/

# Exported CAD output that is regenerated from source. Keep deliberate
# reference renders (see cad_and_blender/**/renders/) tracked — those are
# release artefacts and are intentionally NOT ignored.
*.step
*.stp
*.stl
*.3mf
*.iges
*.igs
*.brep
*.fcstd1
*.dxf
*.svg
*.gltf
*.glb

# ---------------------------------------------------------------------------
# Editors
# ---------------------------------------------------------------------------

.vs/
.vscode/
.idea/
*.swp
*.swo
*~

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------

.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Node / Solidity
# ---------------------------------------------------------------------------
# The Ethereum project is NOT leftover: contracts/ and test/ are tracked, and
# Token Contract CI builds and tests them on every push. package-lock.json is
# deliberately NOT ignored — 'npm ci' requires it, and pinning transitive
# dependencies is what makes the install reproducible and auditable.
# Only build output is ignored.

node_modules/

# Hardhat / Solidity build output. Note: contracts/ is NOT ignored — it holds
# four tracked .sol sources, and ignoring tracked paths is a no-op anyway.
artifacts/
cache/
typechain-types/
deployments/
migrations/

# Stray version-number file from the Solidity tooling
4.5.0